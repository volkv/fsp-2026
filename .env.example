# Local development environment. Copy to .env (`make .env` does it) and adjust if needed.
# .env is read by docker compose (variable interpolation), by `pnpm dev` (SvelteKit $env)
# and by the scripts that start with `node --env-file=.env`. Never commit .env.
# All values below are for the local stand only.

# --- Application (read by src/lib/server/config.ts) ---
# PostgreSQL connection for the app running on the host; the app container gets its own URL in compose.yaml.
DATABASE_URL=postgres://fsp:fsp-local-password@localhost:57432/fsp
# Database of the e2e tests on the same server (playwright.config.ts), recreated empty at every run; fsp_e2e when unset.
# A second copy of the tree that runs its e2e tests at the same time sets a name of its own.
# E2E_DATABASE=fsp_e2e
# Port slot of the e2e run (tests/e2e/helpers/ports.ts): 57175 when unset; a second copy of the tree uses 57185.
# E2E_PORT=57175
# Redis connection for the app running on the host.
REDIS_URL=redis://localhost:57379
# Public origin of the app: Origin check of state-changing requests, links in messages. Dev server by default.
APP_ORIGIN=http://localhost:57173

# --- Field encryption and keyed lookups (docs/domain.md, section 0) ---
# AES-256-GCM keys as <version 1-255>:<base64 of 32 bytes>, comma-separated; the version is stored in each
# ciphertext, so old keys stay listed until data is re-encrypted. Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEYS=1:OkcE/MzaEVbKABVexSsQiVhy4INywZAoF2iYCINTwqo=
# Version used for new ciphertexts.
FIELD_ENCRYPTION_ACTIVE_KEY=1
# Secret of HMAC lookups (email, Telegram chat) and candidate pseudonyms: base64, at least 32 bytes.
# Changing it breaks every stored lookup value and pseudonym.
FIELD_HMAC_SECRET=9K8zDBUlyuRcuTgRLUnCK0joXco/qaGAuP2O/PAwIbc=
# Ed25519 private key seeds signing verification receipts as <key id>:<base64 of 32 bytes>, comma-separated;
# retired keys stay listed while their receipts are checked (docs/contracts.md, section 5.5).
RECEIPT_SIGNING_KEYS=local-1:y2+1vp8w1Lmz9Hlve2yOs58Gz0/Sv4idrB9BYELYnuk=
RECEIPT_ACTIVE_SIGNING_KEY=local-1

# --- PostgreSQL container ---
POSTGRES_DB=fsp
POSTGRES_USER=fsp
# Must match the password in DATABASE_URL.
POSTGRES_PASSWORD=fsp-local-password

# --- Object storage (SeaweedFS on the local stand) ---
# The storage's only identity: the storage service is started with these keys, the app signs its requests with them.
S3_ACCESS_KEY_ID=fsp-storage
S3_SECRET_ACCESS_KEY=fsp-storage-local-password
# Bucket created by the storage at start (private, no anonymous access).
S3_BUCKET=fsp-files
# S3 API of the storage for the app running on the host.
S3_ENDPOINT=http://localhost:57900
S3_REGION=us-east-1

# --- Mail (docs/contracts.md, section 8.1): Mailpit on the local stand ---
SMTP_URL=smtp://localhost:57025
MAIL_FROM=ФСП Карьера <no-reply@fsp-career.local>

# --- Document parsing ---
# docparse through its gateway (docs/contracts.md, section 4); the app container uses http://docparse-gateway:8080 from compose.yaml.
DOCPARSE_URL=http://localhost:57800

# --- Code execution sandbox (docs/contracts.md, section 6) ---
# go-judge through its gateway; the app container uses http://sandbox-gateway:8080 from compose.yaml.
SANDBOX_URL=http://localhost:57950
# Runs one application process sends at once; one more is refused as busy. Positive integer, default 2, matching
# the two programs the sandbox container runs at once (go-judge -parallelism, services/sandbox/Dockerfile).
SANDBOX_MAX_CONCURRENT_RUNS=2

# --- OIDC client to FSP ID (external provider, docs/contracts.md section 2) ---
# In development these point to the FSP simulator, the fsp-mock container (docs/development.md): it has one address
# for the browser and for containers. In production the issuer is https://sso.fsp-russia.ru/realms/fsp and the
# client is issued by FSP. ISSUER, CLIENT_ID, CLIENT_SECRET and REDIRECT_URI are set together, or all are empty
# (login through FSP ID disabled); compose.yaml passes CLIENT_ID and CLIENT_SECRET to the simulator as its only client.
# Issuer URL; discovery is read from {issuer}/.well-known/openid-configuration.
FSP_ID_ISSUER=http://fsp-mock.localhost:57610/realms/fsp
FSP_ID_CLIENT_ID=fsp-career
# Local value only; the simulator refuses a secret shorter than 32 characters.
FSP_ID_CLIENT_SECRET=local-only-fsp-id-client-secret-0000
# Callback of the application: {origin}/auth/fsp/callback; pnpm dev by default, the app container sets its own.
FSP_ID_REDIRECT_URI=http://localhost:57173/auth/fsp/callback
# Space-separated scopes, starting with openid; empty means "openid profile email". The delegated achievements grant
# adds "offline_access fsp_achievements" (docs/contracts.md, sections 1.2 and 2.1).
FSP_ID_SCOPES=openid profile email

# --- Company registry hint (docs/domain.md, section 5.2) ---
# egrul — the public search of the Federal Tax Service (egrul.nalog.ru, no key, an undocumented web form that may ask
# for a captcha); empty — not configured, the operator sees «registry not configured». A hint only, never a verification.
COMPANY_REGISTRY=

# --- Huntflow adapter of outgoing events (docs/contracts.md, section 13.3) ---
# Base of the Huntflow API v2, for example https://api.huntflow.ru/v2; empty — the adapter is off: companies cannot
# connect Huntflow and nothing is sent there. Each company enters its own token when it connects.
HUNTFLOW_API_URL=

# --- Public profiles: Codeforces and GitHub (docs/domain.md, section 9.4) ---
# Roots of the public APIs; empty — the real ones (https://codeforces.com/api, https://api.github.com). Tests point
# them at a local stand-in.
CODEFORCES_API_URL=
GITHUB_API_URL=
# Optional token of GitHub: without it the API allows 60 requests an hour from the server's address. A token without
# scopes is enough, the data read is public.
GITHUB_TOKEN=

# --- FSP achievements source (docs/contracts.md, section 1) ---
# Adapter: mock (the fsp-mock container) or fsp-api; empty disables the import. The four are set together.
FSP_ACHIEVEMENTS_ADAPTER=mock
# Root of the achievements API without /v1.
FSP_ACHIEVEMENTS_BASE_URL=http://fsp-mock.localhost:57610
# HMAC secret of incoming webhooks (X-FSP-Signature), at least 32 characters; shared with the source.
FSP_WEBHOOK_SECRET=local-only-fsp-webhook-secret-00000000
# HMAC secret of consent assertions (X-FSP-Consent-Assertion, grant service_with_assertion), at least 32 characters;
# shared with the source.
FSP_ASSERTION_SECRET=local-only-fsp-assertion-secret-0000000

# --- FSP simulator container ---
# Bearer token of the simulator's /mock/* control endpoints (docs/development.md), at least 32 characters. The
# application uses it in demonstration mode only: the demo reset returns the simulator to its dataset.
FSP_MOCK_CONTROL_TOKEN=local-only-fsp-mock-control-token-00000
# Dataset of the simulator: seed and number of athletes (200–5000). The demo seed generates the same dataset to pick
# the athletes it links, so the simulator and the application read these two values.
FSP_MOCK_SEED=fsp-career-2026-7
FSP_MOCK_ATHLETES=3000

# --- Demonstration mode (docs/development.md, «Демо-данные») ---
# true — the demo seed (pnpm db:seed-demo) and the demo reset (pnpm demo:reset, job demo.reset) may rewrite the whole
# database; anything else — they refuse. On the demo stand the application seeds itself at start and the worker resets
# the stand every night.
DEMO_MODE=false
# Synthetic candidates and vacancies of the seed; defaults 1000 and 300.
DEMO_CANDIDATES=
DEMO_VACANCIES=
# true (default) — the worker resets the stand every night at 00:00 UTC and a demo session ends no later than that;
# false — no reset by itself and a session lives to its own end or its idle time.
DEMO_NIGHTLY_RESET=
# true — review by the jury: demo sessions live by the review terms of retention_policy (a week after the last use);
# only with DEMO_NIGHTLY_RESET=false. Default false.
DEMO_REVIEW_MODE=

# --- Bootstrap administrator (docs/domain.md, section 4.1; docs/development.md, «Начальный администратор») ---
# The first administrator of the stand; others are granted by an administrator. An empty address — none. The
# application's start (build/admin/main.js ensure) creates the account with this password, or grants the role to a
# real active account of the address and leaves its password; `--reset-password` sets the password again. The password
# follows the rules of every account (at least 10 characters, 4 different ones, not the address).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Model adapter (docs/contracts.md, section 3) ---
# Each operation is configured separately; an empty *_BASE_URL disables it and the product uses its fallback mode.
# *_BASE_URL is the base of the OpenAI-compatible API with its version path, as the provider publishes it
# (http://gpu-host:8000/v1): the adapter appends /chat/completions, /embeddings and /rerank. An administrator can also
# switch an operation off while the application runs.
# *_TIMEOUT_MS bounds each background request; *_INTERACTIVE_TIMEOUT_MS bounds a call a person waits for,
# including the wait for a free slot, and must not exceed *_TIMEOUT_MS.
# Text extraction (docs/models.md, «Три режима»). LLM_RUNTIME=api (default): an external model through an
# OpenAI-compatible API — here Gemini Flash through the gateway; the texts of resumes, needs and vacancies go to its
# provider, and every screen that sends them says so. Without LLM_API_KEY extraction is off and the rules read the
# texts. LLM_RUNTIME=vllm: the platform's own vLLM server (LLM_BASE_URL=http://<gpu-host>:8000/v1, LLM_MODEL=extract).
# The key is never committed.
LLM_BASE_URL=https://llmgate.volkv.com/v1
LLM_RUNTIME=api
LLM_MODEL=gemini-flash:latest
LLM_API_KEY=
# Defaults: 120000 ms, interactive 30000 ms, 8 concurrent requests. Measured through the gateway (docs/models.md): a
# request p50 ≈ 9.5 s, p95 ≈ 25 s, at most 51 s for a resume; a need p95 ≈ 18 s; 8 at once without slowing down. Keep
# LLM_MAX_CONCURRENCY at 8 or below for one GPU with an 8B model: above it throughput barely grows and responses
# exceed LLM_TIMEOUT_MS.
LLM_TIMEOUT_MS=
LLM_INTERACTIVE_TIMEOUT_MS=
LLM_MAX_CONCURRENCY=
# Circuit breaker of extract, shared by an interactive call and a background one: after LLM_BREAKER_FAILURES calls in a
# row without an answer (no connection, timeout, 429) the runtime is not called for LLM_BREAKER_COOLDOWN_MS; calls
# answer unavailable (cause cooling_down). Defaults: 3, 30000.
LLM_BREAKER_FAILURES=
LLM_BREAKER_COOLDOWN_MS=
# For pnpm dev and the worker running on the host (docker compose sets its own EMBED_BASE_URL for the app container):
# EMBED_BASE_URL=http://localhost:57820/v1, EMBED_MODEL=bge-m3 (docs/development.md, «Разработка на хосте»).
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_API_KEY=
# Identifier of the embedding space the model produces (docs/domain.md, section 16.2). For the bge-m3 definition in
# src/lib/server/embeddings/definitions.ts (BGE_M3_Q8): bge-m3@aa473d51f451/q:none/d:none/cls/l2/1024/t512/sections-v1.
EMBED_SPACE_ID=
# Defaults: 30000 ms, interactive 5000 ms, batches of 32.
EMBED_TIMEOUT_MS=
EMBED_INTERACTIVE_TIMEOUT_MS=
EMBED_BATCH_SIZE=
# Circuit breaker: after EMBED_BREAKER_FAILURES calls in a row without an answer (no connection, timeout, 429) the
# runtime is not called for EMBED_BREAKER_COOLDOWN_MS; calls answer unavailable (cause cooling_down). Defaults: 3, 30000.
EMBED_BREAKER_FAILURES=
EMBED_BREAKER_COOLDOWN_MS=
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_API_KEY=
# Defaults: 30000 ms, interactive 5000 ms, top 50.
RERANK_TIMEOUT_MS=
RERANK_INTERACTIVE_TIMEOUT_MS=
RERANK_TOP_N=
# Tokens of a query and document pair the reranker keeps (default 1024, the context of bge-reranker-v2-m3); a longer
# document is cut by the runtime instead of failing the whole request. Not above the --max-model-len of the reranker.
RERANK_TRUNCATE_TOKENS=
# Circuit breaker of the reranker, as the embedder's above: a hung tunnel to the GPU costs one interactive deadline, not
# one per search. Defaults: 3, 30000.
RERANK_BREAKER_FAILURES=
RERANK_BREAKER_COOLDOWN_MS=

# --- Telegram notifications (docs/contracts.md, section 8.2) ---
# An empty token disables the channel; the three are set together.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secret of the X-Telegram-Bot-Api-Secret-Token header: 16-256 of A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=

# --- Production server (adapter-node, build/index.js) ---
# Set by the Dockerfile and compose.yaml for the container and by playwright.config.ts for e2e;
# uncomment only to run `node --env-file=.env build/index.js` by hand.
# HOST=127.0.0.1
# PORT=3000
# Public origin of the app, used for CSRF checks of form posts.
# ORIGIN=http://localhost:3000
# Request body limit: 10 MiB resume uploads (src/lib/server/documents/limits.ts) plus multipart overhead.
# BODY_SIZE_LIMIT=11M

# --- Build ---
# Git commit reported by /api/health. Optional locally (taken from git HEAD); required for `docker build`,
# where `make up` and `pnpm docker:build` pass it.
# APP_COMMIT=

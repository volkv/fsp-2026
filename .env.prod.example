# Environment of the demo stand (docker-compose.prod.yml, docs/deploy.md). The real file is /root/fsp-career/.env.prod
# on the server, mode 600; scripts/deploy/init-env.sh creates it there with generated secrets and never overwrites it.
# Never put real values into this template or into the repository.

# Public origin of the stand, without a trailing slash; the FSP simulator's issuer is {origin}/realms/fsp.
PUBLIC_ORIGIN=https://fsp-career.volkv.com

# --- Field encryption and keyed lookups (see .env.example for the formats) ---
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KEY=1
FIELD_HMAC_SECRET=
RECEIPT_SIGNING_KEYS=
RECEIPT_ACTIVE_SIGNING_KEY=stand-1

# --- PostgreSQL ---
POSTGRES_DB=fsp
POSTGRES_USER=fsp
POSTGRES_PASSWORD=

# --- Redis: the password of the stand's Redis, in the URL of the app and the worker ---
REDIS_PASSWORD=

# --- Object storage: the only identity of the storage, used by the app and the worker ---
S3_ACCESS_KEY_ID=fsp-career
S3_SECRET_ACCESS_KEY=
S3_BUCKET=fsp-files
S3_REGION=us-east-1

# --- Mail: stays in the stand's Mailpit ---
MAIL_FROM=ФСП Карьера <no-reply@fsp-career.volkv.com>

# --- FSP simulator: FSP ID client and the achievements source ---
FSP_ID_CLIENT_ID=fsp-career
FSP_ID_CLIENT_SECRET=
FSP_ID_SCOPES=
FSP_WEBHOOK_SECRET=
FSP_ASSERTION_SECRET=
FSP_MOCK_CONTROL_TOKEN=
# Dataset of the simulator, read by the simulator and by the demo seed alike.
FSP_MOCK_SEED=fsp-career-2026-7
FSP_MOCK_ATHLETES=5000

# --- Demonstration mode: the stand seeds itself at start and, by default, resets every night at 00:00 UTC ---
DEMO_MODE=true
DEMO_CANDIDATES=1000
DEMO_VACANCIES=300
# false — no nightly reset: demo sessions live to their own end or idle time, the stand is cleaned by hand (docs/deploy.md).
DEMO_NIGHTLY_RESET=true
# true — review by the jury: a demo session lives a week after its last use (retention_policy), keeps its place while
# used within a day; needs DEMO_NIGHTLY_RESET=false (docs/deploy.md, «Экспертиза»).
DEMO_REVIEW_MODE=false
# stored — the seed gives the model's stored parses of the heroes and scenario needs (seeds/model-parses.json) and reads
# a text without one by the rules, no model call; live — the model reads such a text (paid: docs/deploy.md).
DEMO_SEED_MODEL=stored

# --- Bootstrap administrator: the real administrator of the stand, not a demo account (docs/deploy.md) ---
# Created at the start of the application and kept by the demo reset. The address is a sign-in name: the stand's letters
# stay in its Mailpit. The password is generated by init-env.sh and needed only to create the account (or with
# --reset-password): after the first start move it to a password manager, leave it empty here and recreate the app
# container — the next starts confirm the role by the address alone.
BOOTSTRAP_ADMIN_EMAIL=admin@fsp-career.volkv.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- Company registry hint: empty — not configured ---
COMPANY_REGISTRY=

# --- Optional integrations: empty — disabled (see .env.example) ---
# Except EMBED_*: empty means the stand's own embedder service (docker-compose.prod.yml, docs/deploy.md «Эмбеддер»);
# another runtime needs EMBED_BASE_URL, EMBED_MODEL and EMBED_SPACE_ID together.
# Except LLM_BASE_URL, LLM_RUNTIME and LLM_MODEL too: empty means Claude Opus through the gateway
# (docker-compose.prod.yml, docs/models.md «Три режима»), with the gateway key in LLM_API_KEY; without the key the
# rules read the texts.
# LLM_* and RERANK_* of the models behind the reverse tunnel instead (docs/models.md, «Модели вне стенда: обратный
# туннель»):
#   LLM_BASE_URL=http://fsp-career-gpu-tunnel:57810/v1, LLM_RUNTIME=vllm, LLM_MODEL=extract,
#   RERANK_BASE_URL=http://fsp-career-gpu-tunnel:57801/v1, RERANK_MODEL=bge-reranker-v2-m3,
#   LLM_API_KEY and RERANK_API_KEY — the key of the model machine's runtime.
# Empty LLM_MAX_CONCURRENCY means 4 on the stand: the app and the worker call the runtime together.
# The tunnel's keys are files, not settings: ./gpu-tunnel/ (scripts/deploy/init-env.sh).
LLM_BASE_URL=
LLM_RUNTIME=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=
LLM_INTERACTIVE_TIMEOUT_MS=
LLM_MAX_CONCURRENCY=
LLM_BREAKER_FAILURES=
LLM_BREAKER_COOLDOWN_MS=
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_API_KEY=
EMBED_SPACE_ID=
EMBED_TIMEOUT_MS=
EMBED_INTERACTIVE_TIMEOUT_MS=
EMBED_BATCH_SIZE=
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_API_KEY=
RERANK_TIMEOUT_MS=
RERANK_INTERACTIVE_TIMEOUT_MS=
RERANK_TOP_N=
RERANK_TRUNCATE_TOKENS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

{
	"name": "fsp-career",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"node": ">=24.21.0 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && pnpm fsp-mock:install",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run --project unit --maxWorkers=3",
		"test:integration": "vitest run --project integration --maxWorkers=3",
		"test:e2e": "playwright test --workers=2",
		"db:generate": "drizzle-kit generate --dialect=postgresql --casing=snake_case --schema=./src/lib/server/db/schema --out=./src/lib/server/db/migrations",
		"db:migrate": "node --env-file=.env scripts/migrate.ts",
		"db:seed-taxonomy": "node --env-file=.env scripts/seed-taxonomy.ts",
		"db:seed-legal": "node --env-file=.env scripts/seed-legal.ts",
		"db:seed-policies": "node --env-file=.env scripts/seed-policies.ts",
		"db:seed-assessments": "node --env-file=.env scripts/seed-assessments.ts",
		"demo:build": "vite build --config src/lib/server/demo/bundle.config.ts",
		"db:seed-demo": "pnpm demo:build && node --env-file=.env --enable-source-maps build/demo/main.js seed",
		"demo:reset": "pnpm demo:build && node --env-file=.env --enable-source-maps build/demo/main.js reset",
		"demo:resumes": "docker build --quiet --target runtime -t fsp-docparse:test services/docparse && docker run --rm --network none -u \"$(id -u):$(id -g)\" --tmpfs /tmp:rw,exec -v \"$PWD/scripts/demo-resumes.py:/work/demo-resumes.py:ro\" -v \"$PWD/seeds/resumes:/out\" fsp-docparse:test python /work/demo-resumes.py /out",
		"embeddings:build": "vite build --config src/lib/server/embeddings/bundle.config.ts",
		"db:seed-embedding-space": "pnpm embeddings:build && node --env-file=.env --enable-source-maps build/embeddings/main.js ensure",
		"admin:ensure": "vite build --config src/lib/server/admin/bootstrap/bundle.config.ts && node --env-file=.env --enable-source-maps build/admin/main.js ensure",
		"worker": "vite build --config src/worker/bundle.config.ts && node --env-file=.env --enable-source-maps build/worker/main.js",
		"docker:build": "docker build --build-arg APP_COMMIT=$(git rev-parse --short=12 HEAD) -t fsp-career-app:check .",
		"check:image": "pnpm docker:build && scripts/check-image.sh fsp-career-app:check",
		"docparse:build": "docker build --build-context contracts=contracts --target test -t fsp-docparse:check services/docparse",
		"docparse:lock": "docker run --rm -u \"$(id -u):$(id -g)\" -e UV_CACHE_DIR=/tmp/uv-cache -v \"$PWD/services/docparse:/src\" -w /src ghcr.io/astral-sh/uv:0.12.18-python3.13-trixie-slim uv lock",
		"check:docparse": "pnpm docparse:build && docker run --rm --network none --read-only --tmpfs /tmp:rw,exec,size=1g --memory 3g --cpus 2 --security-opt no-new-privileges --cap-drop ALL fsp-docparse:check",
		"eval:build": "vite build --config src/eval/bundle.config.ts",
		"eval:image": "docker build --target runtime -t fsp-eval:local tools/eval",
		"eval:run": "pnpm eval:build && pnpm eval:image && mkdir -p tools/eval/out && docker run --rm --network host -u \"$(id -u):$(id -g)\" -v \"$PWD:/repo:ro\" -v \"$PWD/tools/eval/out:/out\" fsp-eval:local run --repo /repo --out /out",
		"eval:lock": "docker run --rm -u \"$(id -u):$(id -g)\" -e UV_CACHE_DIR=/tmp/uv-cache -v \"$PWD/tools/eval:/src\" -w /src ghcr.io/astral-sh/uv:0.12.18-python3.13-trixie-slim uv lock",
		"check:eval": "docker build --build-context taxonomy=taxonomy --target test -t fsp-eval:check tools/eval && docker run --rm --network none --read-only --tmpfs /tmp:rw,size=512m --memory 2g --cpus 2 --security-opt no-new-privileges --cap-drop ALL fsp-eval:check",
		"fsp-mock:install": "pnpm -C services/fsp-mock install --frozen-lockfile",
		"check:fsp-mock": "pnpm fsp-mock:install && pnpm -C services/fsp-mock check && docker build -t fsp-mock:check services/fsp-mock",
		"docs:licenses": "node scripts/docs/licenses.ts",
		"docs:build": "node scripts/docs/build.ts",
		"check:sandbox": "vitest run --project integration tests/integration/sandbox.test.ts",
		"check:fast": "pnpm lint && pnpm check && pnpm test:unit",
		"check:all": "pnpm check:fast && pnpm test:integration && pnpm build && docker compose up -d --wait postgres redis storage mailpit fsp-mock && pnpm test:e2e && pnpm check:image && pnpm check:docparse && pnpm check:eval && pnpm check:fsp-mock"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.2.1",
		"aws4fetch": "^1.0.20",
		"drizzle-orm": "^0.45.3",
		"fast-xml-parser": "5.11.1",
		"nodemailer": "^10.0.10",
		"openid-client": "^6.8.8",
		"postgres": "^3.4.9",
		"redis": "^6.2.1",
		"swagger-ui-dist": "^5.33.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.47.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testcontainers/postgresql": "^12.1.0",
		"@testcontainers/redis": "^12.1.0",
		"@types/node": "^24.13.6",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"testcontainers": "^12.1.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
